BASE_URL=https://dev-settlement-admin.berriz.in/
API_BASE_URL=https://dev-settlement-admin-api.berriz.in
TEST_EMAIL=
TEST_PASSWORD=
HEADLESS=false
# Mặc định chạy trên Microsoft Edge (msedge). BROWSER=chromium → Chromium của Playwright
BROWSER=
DEFAULT_TIMEOUT=15000

# Bộ 3 giá trị bypass đăng nhập UI (né Okta SSO) cho các test cần phiên đã đăng nhập.
# Lấy từ DevTools > Application > Cookies trên domain .berriz.in sau khi đăng nhập thật:
#   AUTH_TOKEN         = giá trị cookie "auth_token"
#   AUTH_ID_TOKEN       = giá trị cookie "id_token"
#   AUTH_TOKEN_EXPIRES  = giá trị cookie "token_expires"
# Set vào đúng 3 cookie này qua src/setup/auth.setup.ts — để trống AUTH_TOKEN thì setup-auth tự skip.
# Cookie hết hạn sau ~1 giờ kể từ khi đăng nhập — cần lấy lại giá trị mới khi hết hạn.
AUTH_TOKEN=
AUTH_ID_TOKEN=
AUTH_TOKEN_EXPIRES=
# Refresh token Okta của account gốc — lấy "refreshToken" (dạng text) trong localStorage["okta-token-storage"].
# Token xoay vòng mỗi lần dùng: đóng/logout tab đã lấy token trước khi chạy. Test tự ghi token mới về đây.
OKTA_REFRESH_TOKEN=

# Account duyệt (role APPROVER, KHÁC danh tính account gốc) — cho các TC cần 승인/반려 trên 변경 승인 (US120).
# Cùng định dạng bộ key trên, tiền tố APPROVER_. Để trống → test dùng approverApi hoặc switchAccount(page, 'approver') được skip.
APPROVER_OKTA_REFRESH_TOKEN=
APPROVER_AUTH_TOKEN=
APPROVER_AUTH_ID_TOKEN=
APPROVER_AUTH_TOKEN_EXPIRES=
